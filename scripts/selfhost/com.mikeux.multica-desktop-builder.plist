<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: build the macOS desktop app from the self-hosted checkout
  whenever a new v*-mikeux.* tag appears, and publish the installer to the
  matching Forgejo release so /download serves it.

  Install (adjust the path if your clone is not ~/src/multica):
    cp scripts/selfhost/com.mikeux.multica-desktop-builder.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.mikeux.multica-desktop-builder.plist
  Run once now instead of waiting for the interval:
    launchctl start com.mikeux.multica-desktop-builder
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.mikeux.multica-desktop-builder.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mikeux.multica-desktop-builder</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mike/src/multica/scripts/selfhost/build-desktop-macos.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a minimal PATH; Go and pnpm usually live in one of these. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- launchd does not inherit the interactive macOS system proxy. -->
    <key>HTTP_PROXY</key>
    <string>http://192.168.0.200:7893</string>
    <key>HTTPS_PROXY</key>
    <string>http://192.168.0.200:7893</string>
    <key>ALL_PROXY</key>
    <string>http://192.168.0.200:7893</string>
    <key>NO_PROXY</key>
    <string>localhost,127.0.0.1,192.168.0.0/16,.mikeux.com</string>
    <!-- Existing SSH identity; no API token is copied to the Mac. -->
    <key>MULTICA_PROGRESS_SSH_HOST</key>
    <string>ubuntu26</string>
    <key>MULTICA_PROGRESS_SSH_OPTIONS</key>
    <string>-o HostName=dm.mikeux.com</string>
  </dict>
  <!-- 30 minutes; a build only runs when a release is missing its installer. -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/mike/Library/Logs/multica-desktop-builder.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mike/Library/Logs/multica-desktop-builder.err.log</string>
</dict>
</plist>
