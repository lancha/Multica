[Unit]
Description=Deploy a promoted Multica candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/Multica
EnvironmentFile=%h/.config/multica/deploy.env
ExecStart=/bin/bash %h/src/Multica/scripts/selfhost/deploy-ubuntu.sh
TimeoutStartSec=45min
UMask=0077
